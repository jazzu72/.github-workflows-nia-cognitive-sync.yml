import os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
import secrets

KEY_PATH = "niabrain/vault/vault.key"

def load_key():
    if not os.path.exists(KEY_PATH):
        key = AESGCM.generate_key(bit_length=256)
        os.makedirs(os.path.dirname(KEY_PATH), exist_ok=True)
        with open(KEY_PATH, "wb") as f:
            f.write(key)
    return open(KEY_PATH, "rb").read()

KEY = load_key()

def encrypt(data: bytes) -> bytes:
    nonce = secrets.token_bytes(12)
    aesgcm = AESGCM(KEY)
    ciphertext = aesgcm.encrypt(nonce, data, None)
    return nonce + ciphertext

def decrypt(blob: bytes) -> bytes:
    nonce, ciphertext = blob[:12], blob[12:]
    aesgcm = AESGCM(KEY)
    return aesgcm.decrypt(nonce, ciphertext, None)
import sqlite3, json, hashlib
from datetime import datetime
from .crypto import encrypt, decrypt

DB_PATH = "niabrain/vault/ledger.db"

def init():
    conn = sqlite3.connect(DB_PATH)
    conn.execute("""
    CREATE TABLE IF NOT EXISTS ledger (
        id INTEGER PRIMARY KEY,
        timestamp TEXT,
        type TEXT,
        amount REAL,
        currency TEXT,
        encrypted_payload BLOB,
        prev_hash TEXT,
        entry_hash TEXT
    )
    """)
    conn.commit()
    conn.close()

def last_hash(conn):
    cur = conn.execute("SELECT entry_hash FROM ledger ORDER BY id DESC LIMIT 1")
    row = cur.fetchone()
    return row[0] if row else "GENESIS"

def add_entry(type, amount, payload, currency="USD"):
    conn = sqlite3.connect(DB_PATH)
    prev = last_hash(conn)
    ts = datetime.utcnow().isoformat() + "Z"

    encrypted = encrypt(json.dumps(payload).encode())
    raw = f"{ts}{type}{amount}{currency}{encrypted}{prev}".encode()
    entry_hash = hashlib.sha256(raw).hexdigest()

    conn.execute("""
    INSERT INTO ledger (timestamp,type,amount,currency,encrypted_payload,prev_hash,entry_hash)
    VALUES (?,?,?,?,?,?,?)
    """, (ts, type, amount, currency, encrypted, prev, entry_hash))

    conn.commit()
    conn.close()

def read_entries(limit=100):
    conn = sqlite3.connect(DB_PATH)
    rows = conn.execute("SELECT * FROM ledger ORDER BY id DESC LIMIT ?", (limit,))
    out = []
    for r in rows:
        out.append({
            "timestamp": r[1],
            "type": r[2],
            "amount": r[3],
            "currency": r[4],
            "payload": json.loads(decrypt(r[5]).decode()),
            "hash": r[7]
        })
    conn.close()
    return out

