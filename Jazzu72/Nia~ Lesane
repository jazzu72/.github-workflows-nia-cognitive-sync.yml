name: Nia AutoBuild (Safe)

on:
  workflow_dispatch:
  issue_comment:
    types: [created]

jobs:
  autobuild:
    if: contains(github.event.comment.body, '/nia-build')
    runs-on: windows-latest

    permissions:
      contents: read
      pull-requests: write

    steps:
      - uses: actions/checkout@v4

      - name: Run AutoBuilder
        env:
          NIA_MODE: "PROPOSE_ONLY"
        run: |
          pwsh ./scripts/Invoke-AutoBuild.ps1

      - name: Open PR
        uses: peter-evans/create-pull-request@v6
        with:
          title: "Nia: Proposed System Improvements"
          body: "Auto-generated by Nia (policy-bounded)"
          branch: nia/autobuild
